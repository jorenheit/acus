+template <ws::Compare16Operand W>
+Assembler::Bool16Result<W> Assembler::greater16Destructive(W const &lhs, Compare16Rhs const &rhs) {
+  pushPtr();
+  moveTo(lhs[0]);
+  greater16Kernel(lhs[1], rhs[0], rhs[1], Temps<3>{lhs[2], lhs[3], rhs[2]});
+  popPtr();
+  return lhs.template transformed<
