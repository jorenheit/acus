+template <ws::SingleCell W>
+Assembler::Data8Result<W> Assembler::eqDestructive(W const &lhs, SingleCell const &rhs) {
+  pushPtr();
+  moveTo(lhs[0]);
+  eqKernel(rhs[0]);
+  popPtr();
+  return lhs;
+}
+
+template <ws::Compare16Operand W>
+Assembler::Bool16Result<W> Assembler::eq16Destructive(W const &lhs, Compare16Rhs const &rhs) {
+  pushPtr();
+  moveTo(lhs[0]);
+  eq16Kernel(lhs[1], rhs[0], rhs[1], Temps<1>{lhs[2]});
+  popPtr();
+  return lhs.template transformed<
+    ws::Replace<0, ws::Data<>>,
+    ws::Replace<1, ws::Scratch>
+  >();
+}
+
+template <ws::SingleAndScratch W>
+Assembler::Data8Result<W> Assembler::lessDestructive(W const &lhs, SingleCell const &rhs) {
+  constexpr size_t scratch = W::template ScratchOffset<1>;
+  pushPtr();
+  moveTo(lhs[0]);
+  lessKernel(rhs[0], Temps<1>{lhs[scratch]});
+  popPtr();
+  return lhs;
+}
+
+template <ws::Compare16Operand W>
+Assembler::Bool16Result<W> Assembler::less16Destructive(W const &lhs, Compare16Rhs const &rhs) {
+  pushPtr();
+  moveTo(lhs[0]);
+  less16Kernel(lhs[1], rhs[0], rhs[1], Temps<4>{lhs[2], lhs[3], rhs[2], rhs[3]});
+  popPtr();
+  return lhs.template transformed<
+    ws::Replace<0, ws::Data<>>,
+    ws::Replace<1, ws::Scratch>
+  >();
+}
+
+template <ws::SingleAndScratch W>
+Assembler::Data8Result<W> Assembler::lessOrEqualDestructive(W const &lhs, SingleCell const &rhs) {
+  constexpr size_t scratch = W::template ScratchOffset<1>;
+  pushPtr();
+  moveTo(lhs[0]);
+  lessOrEqualKernel(rhs[0], Temps<1>{lhs[scratch]});
+  popPtr();
+  return lhs;
+}
+
+template <ws::Compare16Operand W>
+Assembler::Bool16Result<W> Assembler::lessOrEqual16Destructive(W const &lhs, Compare16Rhs const &rhs) {
+  pushPtr();
+  moveTo(lhs[0]);
+  lessOrEqual16Kernel(lhs[1], rhs[0], rhs[1], Temps<3>{lhs[2], lhs[3], rhs[2]});
+  popPtr();
+  return lhs.template transformed<
+    ws::Replace<0, ws::Data<>>,
+    ws::Replace<1, ws::Scratch>
+  >();
+}
+
+template <ws::SingleAndScratch W>
+Assembler::Data8Result<W> Assembler::greaterDestructive(W const &lhs, SingleCell const &rhs) {
+  constexpr size_t scratch = W::template ScratchOffset<1>;
+  pushPtr();
+  moveTo(lhs[0]);
+  greaterKernel(rhs[0], Temps<1>{lhs[scratch]});
+  popPtr();
+  return lhs;
+}
