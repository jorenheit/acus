#!/usr/bin/env python3
"""Compile Acus sugar source files to Brainfuck."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import tempfile
from typing import Iterable, Sequence


PROGRAM_NAME = "__acs_program"
ENTRY_FUNCTION = "main"
VERSION = "0.1.0"


class AcsError(RuntimeError):
    """An error that should be reported without a Python traceback."""


def _path_for_line_directive(path: Path) -> str:
    """Return a quoted C++ string suitable for a #line directive."""
    return json.dumps(str(path), ensure_ascii=False)


def _render_cpp(source: str, source_name: Path) -> str:
    source_path = _path_for_line_directive(source_name)

    program_contents = f'''
'''

    return f'''// Generated by acs {VERSION}. Do not edit.
#include <exception>
#include <iostream>

#include <acus/sugar/sugar.h>
#include <acus/sugar/sugar_std.h>

using namespace acus;
using namespace acus::sugar;
using namespace acus::sugar::io;

int main() try {{
  program_("{PROGRAM_NAME}", "{ENTRY_FUNCTION}");
  {{
#line 1 {source_path}
{source}
#line 1 "<acs-wrapper>"    
  }}
  endProgram();

  std::cout << generateBrainfuck("{PROGRAM_NAME}");
  return 0;
}}
catch (std::exception const &error) {{
  std::cerr << "acs: " << error.what() << '\\n';
  return 1;
}}
'''


def _split_command(command: str) -> list[str]:
    parts = shlex.split(command)
    if not parts:
        raise AcsError("the compiler command is empty")
    return parts


def _print_command(command: Sequence[str]) -> None:
    print(f"+ {shlex.join(command)}", file=sys.stderr)


def _run(command: Sequence[str], *, verbose: bool, stdout=None) -> int:
    if verbose:
        _print_command(command)
    try:
        completed = subprocess.run(command, stdout=stdout, check=False)
    except FileNotFoundError as error:
        raise AcsError(f"could not execute {command[0]!r}: command not found") from error
    except OSError as error:
        raise AcsError(f"could not execute {command[0]!r}: {error}") from error
    return completed.returncode


def _existing_source_root(script_path: Path) -> Path | None:
    """Detect an Acus checkout when acs is run from its frontend directory."""
    candidate = script_path.resolve().parent.parent
    header = candidate / "include" / "acus" / "sugar" / "sugar.h"
    if header.is_file():
        return candidate
    return None


def _add_unique(items: list[Path], item: Path) -> None:
    resolved = item.expanduser().resolve()
    if resolved not in items:
        items.append(resolved)


def _library_configuration(args: argparse.Namespace, script_path: Path) -> tuple[list[Path], list[Path], Path | None]:
    include_dirs: list[Path] = []
    library_dirs: list[Path] = []
    exact_library = args.acus_lib.expanduser().resolve() if args.acus_lib else None

    root_value = args.acus_root or os.environ.get("ACUS_ROOT")
    prefix_value = args.acus_prefix or os.environ.get("ACUS_PREFIX")

    root: Path | None = Path(root_value) if root_value else None
    if root is None and prefix_value is None and exact_library is None:
        root = _existing_source_root(script_path)

    if root is not None:
        root = root.expanduser().resolve()
        _add_unique(include_dirs, root / "include")
        _add_unique(library_dirs, root / "lib")
        local_archive = root / "lib" / "libacus.a"
        if exact_library is None and local_archive.is_file():
            exact_library = local_archive

    if prefix_value is not None:
        prefix = Path(prefix_value).expanduser().resolve()
        _add_unique(include_dirs, prefix / "include")
        _add_unique(library_dirs, prefix / "lib")

    for include_dir in args.include_dir:
        _add_unique(include_dirs, include_dir)
    for library_dir in args.library_dir:
        _add_unique(library_dirs, library_dir)

    return include_dirs, library_dirs, exact_library


def _read_source(path_text: str) -> tuple[str, Path]:
    if path_text == "-":
        return sys.stdin.read(), Path("<stdin>.acs")

    path = Path(path_text).expanduser()
    if path.suffix != ".acs":
        raise AcsError(f"input file must have the .acs extension: {path}")

    try:
        source = path.read_text(encoding="utf-8")
    except FileNotFoundError as error:
        raise AcsError(f"input file does not exist: {path}") from error
    except OSError as error:
        raise AcsError(f"could not read {path}: {error}") from error

    return source, path.resolve()


def _make_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="acs",
        description="Compile an Acus sugar .acs file to Brainfuck.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='''Source format (default):
  The .acs file is inserted into the Acus program scope and should define
  function_<void()>("main") plus any helper functions.

  Use --main-body when the file contains only statements for main.

Examples:
  acs hello.acs > hello.bf
  acs hello.acs -o hello.bf --acus-root ~/src/acus
  acs hello.acs --compiler clang++ --acus-prefix ~/.local
''',
    )

    parser.add_argument("source", help="input .acs file, or - for standard input")
    parser.add_argument("-o", "--output", type=Path, help="write Brainfuck to FILE instead of standard output")
    parser.add_argument(
        "--compiler",
        default=os.environ.get("CXX", "c++"),
        metavar="COMMAND",
        help="C++ compiler command (default: $CXX or c++)",
    )
    parser.add_argument("--std", default="c++23", metavar="STANDARD", help="C++ language standard (default: c++23)")

    location = parser.add_argument_group("Acus library location")
    location.add_argument("--acus-root", type=Path, metavar="DIR", help="Acus source/build tree; adds DIR/include and DIR/lib")
    location.add_argument("--acus-prefix", type=Path, metavar="DIR", help="Acus installation prefix; adds DIR/include and DIR/lib")
    location.add_argument("--acus-lib", type=Path, metavar="FILE", help="link this exact Acus library instead of -lacus")
    location.add_argument("-I", "--include-dir", action="append", type=Path, default=[], metavar="DIR", help="add a C++ include directory; repeatable")
    location.add_argument("-L", "--library-dir", action="append", type=Path, default=[], metavar="DIR", help="add a linker library directory; repeatable")

    build = parser.add_argument_group("Build options")
    build.add_argument("--cxxflag", action="append", default=[], metavar="FLAG", help="pass FLAG to the compiler; repeatable")
    build.add_argument("--ldflag", action="append", default=[], metavar="FLAG", help="pass FLAG to the linker; repeatable")
    build.add_argument("--emit-cpp", type=Path, metavar="FILE", help="also write the generated C++ wrapper to FILE")
    build.add_argument("--build-dir", type=Path, metavar="DIR", help="use and retain DIR for generated build files")
    build.add_argument("--keep-build", action="store_true", help="retain the temporary C++ file and generator executable")
    build.add_argument("-v", "--verbose", action="store_true", help="show compiler and generator commands")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")

    return parser


def _compile_command(
    args: argparse.Namespace,
    cpp_path: Path,
    executable_path: Path,
    include_dirs: Iterable[Path],
    library_dirs: Iterable[Path],
    exact_library: Path | None,
) -> list[str]:
    command = _split_command(args.compiler)
    command.append(f"-std={args.std}")
    command.extend(args.cxxflag)

    for include_dir in include_dirs:
        command.extend(("-I", str(include_dir)))

    command.append(str(cpp_path))

    for library_dir in library_dirs:
        command.extend(("-L", str(library_dir)))

    if exact_library is not None:
        command.append(str(exact_library))
    else:
        command.append("-lacus")

    command.extend(args.ldflag)
    command.extend(("-o", str(executable_path)))
    return command


def _write_output(generator: Sequence[str], output: Path | None, verbose: bool) -> int:
    if output is None:
        return _run(generator, verbose=verbose, stdout=sys.stdout.buffer)

    output = output.expanduser()
    output.parent.mkdir(parents=True, exist_ok=True)
    temporary_output = output.with_name(f".{output.name}.tmp-{os.getpid()}")

    try:
        with temporary_output.open("wb") as stream:
            result = _run(generator, verbose=verbose, stdout=stream)
        if result == 0:
            temporary_output.replace(output)
        else:
            temporary_output.unlink(missing_ok=True)
        return result
    except OSError as error:
        temporary_output.unlink(missing_ok=True)
        raise AcsError(f"could not write {output}: {error}") from error


def main(argv: Sequence[str] | None = None) -> int:
    args = _make_parser().parse_args(argv)

    try:
        source, source_name = _read_source(args.source)
        cpp_source = _render_cpp(source, source_name)

        if args.emit_cpp is not None:
            emit_path = args.emit_cpp.expanduser()
            emit_path.parent.mkdir(parents=True, exist_ok=True)
            emit_path.write_text(cpp_source, encoding="utf-8")

        include_dirs, library_dirs, exact_library = _library_configuration(args, Path(__file__))

        temporary_context: tempfile.TemporaryDirectory[str] | None = None
        if args.build_dir is not None:
            build_dir = args.build_dir.expanduser().resolve()
            build_dir.mkdir(parents=True, exist_ok=True)
        elif args.keep_build:
            build_dir = Path(tempfile.mkdtemp(prefix="acs-"))
            print(f"acs: build files retained in {build_dir}", file=sys.stderr)
        else:
            temporary_context = tempfile.TemporaryDirectory(prefix="acs-")
            build_dir = Path(temporary_context.name)

        try:
            cpp_path = build_dir / "program.cpp"
            executable_name = "program.exe" if os.name == "nt" else "program"
            executable_path = build_dir / executable_name
            cpp_path.write_text(cpp_source, encoding="utf-8")

            compile_command = _compile_command(
                args,
                cpp_path,
                executable_path,
                include_dirs,
                library_dirs,
                exact_library,
            )
            compile_result = _run(compile_command, verbose=args.verbose)
            if compile_result != 0:
                return compile_result

            return _write_output((str(executable_path),), args.output, args.verbose)
        finally:
            if temporary_context is not None:
                temporary_context.cleanup()

    except AcsError as error:
        print(f"acs: error: {error}", file=sys.stderr)
        return 2
    except OSError as error:
        print(f"acs: error: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
